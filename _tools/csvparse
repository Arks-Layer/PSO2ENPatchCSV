class prettyHelp(argparse.ArgumentDefaultsHelpFormatter):
	def _format_action_invocation(self, action):
		if action.option_strings:
			return ', '.join(action.option_strings)
		return super()._format_action_invocation(action)

class CSVJsonConvert:
	def __init__(self):
		self.parser = argparse.ArgumentParser(
			prog="csvparse",
			description="A glorified needle in a haystack",
			formatter_class=lambda prog: prettyHelp(prog, width=100)
		)
		self._configArgs()

	def mapping(self, replacements):
		with open(replacements, "r", encoding="utf-8") as json_File:
			return json.load(json_File)

	def tlmapping(self):
		mapping = {}

		for source in ES_SOURCE_FILES:
			with open(source, "r", encoding="utf-8") as json_File:
				jsonData = json.load(json_File)

			for entry in jsonData:
				key = entry.get("jp_text")
				value = entry.get("tr_text")

				if not key or not value:
					continue

				if key.startswith('\uffe5'):
					continue

				mapping[key.replace('\u3000', ' ')] = value

		return mapping

	def cvLine(self, text, prefix):
		for line in (text or "").split('\n'):
			if line.startswith(prefix):
				return line[len(prefix):].strip()

		return None

	def voicesInMyHead(self):
		mapping = {}
		with open(PSO2_VOICE, "r", encoding="utf-8") as jsonFile:
			jsonData = json.load(jsonFile)

		for entry in jsonData:
			key = entry.get("jp_text")
			value = entry.get("tr_text")

			if not key or not value:
				continue

			if key.startswith('\uffe5'):
				continue

			jpCV = self.cvLine(entry.get("jp_explain"), '\uff23\uff36')
			trCV = self.cvLine(entry.get("tr_explain"), 'CV: ')

			if not trCV:
				continue

			key = re.sub(r'^T\d', '', key).replace('\u30dc\u30a4\u30b9', '').strip()
			value = re.sub(r'\s*Voice\b', '', re.sub(r'^T\d\s*', '', value)).strip()

			if not key or not value:
				continue

			mapping[key] = f'{value}/{trCV}'

			if jpCV:
				mapping[f'{key}/{jpCV}'] = f'{value}/{trCV}'
		return mapping

	def momapping(self):
		jpPattern = re.compile(r'\u300c(.*)\u300d')
		trPattern = re.compile(r'"(.*)"')
		mapping = {}

		for source, split_category in MOTION_SOURCES:
			with open(source, "r", encoding="utf-8") as json_File:
				jsonData = json.load(json_File)

			for entry in jsonData:
				key = entry.get("jp_text")
				value = entry.get("tr_text")

				if not key or not value:
					continue

				if key.startswith('\uffe5'):
					continue

				jpMatch = jpPattern.search(key)
				trMatch = trPattern.search(value)

				if jpMatch:
					key = jpMatch.group(1)

				if trMatch:
					value = trMatch.group(1)

				if split_category:
					key = key.split('\uff1a', 1)[-1]
					value = value.split(': ', 1)[-1]

				mapping[key] = value

		return mapping

	def replacer(self, input_file, replacements, exact=False, prefixes=None):
		df = pd.read_csv(input_file, dtype=str, header=None, encoding='utf-8')
		quote_pattern = re.compile(r'"(.*?)"')

		def replace_text(cell):
			match = quote_pattern.search(str(cell))
			if match:
				inner_text = match.group(1)

				if inner_text.startswith('\uffe5'):
					return cell

				if exact:
					modified_text = replacements.get(inner_text)

					if modified_text is None:
						return cell
				else:
					modified_text = inner_text

					for key, value in replacements.items():
						if key in modified_text:
							modified_text = modified_text.replace(key, value)

					if modified_text == inner_text:
						return cell

				return cell.replace(inner_text, modified_text)
			return cell

		if prefixes is None:
			df = df.apply(lambda col: col.map(replace_text))
		else:
			rows = df[0].fillna('').str.startswith(prefixes)
			df.loc[rows, 1] = df.loc[rows, 1].map(replace_text)

		df.to_csv(input_file, index=False, header=False, encoding='utf-8')

	def _configArgs(self): # define commands
		group = self.parser.add_mutually_exclusive_group(required=True)

		group.add_argument("-r", "--replace", nargs=2, metavar=("<input file>", "<json dictionary>"), help="Fill in lines from dictionary.")
		group.add_argument("-t", "--translate", action='store_true', help="Fill in lines from a list-style dictionary using jp_text/tr_text pairs.")
		group.add_argument("-m", "--motion", action='store_true', help="Translate lobby actions and motions in common.csv.")
		group.add_argument("-v", "--voice", action='store_true', help="Translate character voices.")

	def parseArgs(self): # parse commands
		args = self.parser.parse_args()

		if args.replace:
			self.replacer(args.replace[0], self.mapping(args.replace[1]))

		if args.translate:
			replacements = self.tlmapping()
			for source in PSO2_SALON:
				self.replacer(source, replacements, exact=True)

		if args.motion:
			self.replacer(REBOOT_COMMON_CSV, self.momapping(), exact=True, prefixes=MOTION_PREFIXES)

		if args.voice:
			self.replacer(PSO2_VOICE, self.voicesInMyHead(), exact=True, prefixes=VOICE_PREFIXES)

if __name__ == "__main__":
	app = CSVJsonConvert()
	app.parseArgs()
